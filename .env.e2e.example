# Copy to .env.e2e. Used by `pnpm db:e2e` and `pnpm dev:e2e`; never points at production.
DATABASE_URL=postgres://xevo:xevo@localhost:5444/xevo_e2e
XEVO_E2E_FAKES=1
# Magic Shot video: pose correction (fake provider in fakes mode)
XEVO_VIDEO_PROVIDER=pose-correction
BETTER_AUTH_URL=http://localhost:3050
PUBLIC_BASE_URL=http://localhost:3050
ADMIN_HUB_GATE_PASSWORD=e2e-admin-gate
ADMIN_TRAIN_SECRET=e2e-admin-gate
WEB_TEST_ORIGIN=http://localhost:8090

# Paste into Railway → Variables (RAW). App hits https://bexevo-production.up.railway.app/
# AI runs on your PC: run Unsloth :8888 + Comfy :8188 + SEPARATE ngrok tunnels to those ports.
#
# One ngrok hostname per service (see Workflows/ngrok/ngrok.yml.example):
#   XEVO_LLM_BASE_URL=https://sloth.ngrok.app/v1
#   COMFYUI_BASE_URL=https://comfi.ngrok.dev
# Do NOT point both at carylon-....ngrok-free.dev (that caused random 404 / Comfy failures).

ENVIRONMENT=PRODUCTION

BETTER_AUTH_URL=https://bexevo-production.up.railway.app/
PUBLIC_VIDEO_BASE_URL=https://bexevo-production.up.railway.app/
PUBLIC_BASE_URL=https://bexevo-production.up.railway.app/

DATABASE_URL=

BETTER_AUTH_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

PRIVACY_CONTACT_EMAIL=knoome@proton.me

FAL_API_KEY=
FAL_KEY=
FAL_CORRECTION_LORA_URL=

GEMINI_API_KEY=
OPENAI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_TRAIN_SECRET=xevodev
ADMIN_HUB_GATE_PASSWORD=xevodev

MODAL_WEBHOOK_URL=https://kyle-65625--padel-analyzer-analyze-video.modal.run/
TRAIN_MODAL_WEBHOOK_URL=https://kyle-65625--padel-trainset-process-video.modal.run/

ALLOW_GUEST_TECHNIQUE=true

YOLO_DETECTION_ENABLED=true
YOLO_DETECTION_WRITE_ENABLED=true
YOLO_DETECTION_CONFIDENCE=0.08
YOLO_RACKET_CONFIDENCE=0.01
YOLO_BALL_CONFIDENCE=0.10
YOLO_DETECTION_IMGSZ=1280
YOLO_DETECTION_IOU=0.70
YOLO_DETECTION_LOGS=true

XEVO_TEXT_PROVIDER=xevo
XEVO_LLM_BASE_URL=https://sloth.ngrok.app/v1
XEVO_LLM_MODEL=unsloth/Qwen3.5-4B-GGUF
XEVO_LLM_API_KEY=
XEVO_LLM_TIMEOUT_MS=600000
XEVO_LLM_MAX_TOKENS=32768
XEVO_ANALYZE_MAX_POSE_FRAMES=12
# Comfy correction images per request (default 5, max 20)
XEVO_CORRECTION_MAX_FRAMES=5

COMFYUI_BASE_URL=https://comfi.ngrok.dev
# Qwen Image Edit GGUF + union OpenPose CN (production)
COMFYUI_WORKFLOW_PATH=./workflows/qwen_image_edit_plus_gguf_correction.api.json
COMFYUI_LOAD_IMAGE_NODE_ID=41,83
COMFYUI_PROMPT_NODE_ID=68
COMFYUI_PROMPT_INPUT_KEY=prompt
COMFYUI_PROMPT_FORMAT=qwen
COMFYUI_MASK_NODE_ID=92
# Mask aligned to player scale node 90 (1.0 MP). A/B: comment out COMFYUI_MASK_NODE_ID if limbs frozen.
# COMFYUI_PLAYER_MEGAPIXELS=1.0
# COMFYUI_DEBUG_MASK=true
COMFYUI_TIMEOUT_MS=420000
# Coaching corrections (default): visible limb movement toward pro + coach deltas
COMFYUI_CORRECTION_INTENSITY=coaching
COMFYUI_DENOISE=0.92
COMFYUI_CONTROLNET_STRENGTH=0.35
COMFYUI_CONTROLNET_STRENGTH_PRO=0.78
COMFYUI_MASK_DILATE_PCT=0.20
COMFYUI_REF_MEGAPIXELS=1.0
# Subtle: COMFYUI_CORRECTION_INTENSITY=subtle
# SDXL rollback: COMFY-SDXL-DEPS.md + sdxl_correction_openpose_faceid.api.json

XEVO_DISABLE_IMAGE_FALLBACK=true
